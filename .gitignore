# Large or generated data files (preserve directory placeholders via .gitkeep)
# Note: synthetic demo data is reproducible via 'make data' or 'python -m src.data.generate_data'
data/raw/*.csv
data/processed/*.csv
!data/raw/.gitkeep
!data/processed/.gitkeep

# Saved model artifacts (reproducible via 'make train')
models/*.joblib
!models/.gitkeep
