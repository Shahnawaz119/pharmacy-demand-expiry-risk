# Large or generated data files (preserve directory placeholders via .gitkeep)
# Note: raw data and train/val/test splits stay local
data/raw/*.csv
data/processed/train_*.csv
data/processed/val_*.csv
data/processed/test_*.csv
!data/raw/.gitkeep
!data/processed/.gitkeep
!data/processed/products.csv
!data/processed/batches.csv
!data/processed/calendar.csv
!data/processed/daily_sales.csv
!data/processed/demand_features.csv
!data/processed/expiry_risk_features.csv

# Saved model artifacts: track primary production bundle for cloud deployment
models/demand_*.joblib
models/expiry_*.joblib
!models/pharmacy_forecaster.joblib
!models/.gitkeep
